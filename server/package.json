{
    "name": "trd",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "timestamp": "date",
        "wait_for_infra": "npx wait-on -l tcp:db:3306 tcp:redis:6379",
        "rimraf": "./node_modules/rimraf/bin.js",
        "build": "tsc -P tsconfig.json",
        "build:watch": "npm run build -- --watch --preserveWatchOutput --pretty",
        "server": "npm run server:build && node -r source-map-support/register ./dist/server/index.js",
        "server:build:clean": "rimraf dist/server",
        "server:dev": "npm run server:build:clean && tsc-watch --skipLibCheck --pretty --preserveWatchOutput -P tsconfig.json --onSuccess \"node -r source-map-support/register ./dist/server/index.js\"",
        "client:dev": "cd client && npx webpack-dev-server --content-base ./dist --hot --inline --color --port $WEBPACK_DEV_SERVER_PORT --host 0.0.0.0",
        "dev": "echo Hello; concurrently \"npm run server:dev\" \"npm run client:dev\"",
        "lint": "eslint '*/**/*.{js,ts,tsx}' --quiet",
        "lint:fix": "eslint '*/**/*.{js,ts,tsx}' --fix",
        "lint:watch": "nodemon -w src -e ts -x \"npm run lint || exit 0\"",
        "dist:run": "npm run timestamp; node -r source-map-support/register dist/cli/index.js",
        "api-server": "npm run dist:run -- --api-server",
        "run-debug": "npm run dist:run -- --debug",
        "run-debug:watch": "nodemon -w ./dist -e js -x \"npm run run-debug || exit 0\"",
        "api-server:watch": "nodemon -w ./dist -e js -x \"npm run api-server || exit 0\""
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/auto-bind": "^2.1.0",
        "@types/cli-progress": "^3.8.0",
        "@types/deep-diff": "^1.0.0",
        "@types/express-routemap": "^1.1.1",
        "@types/morgan": "^1.9.1",
        "@types/redis": "^2.8.24",
        "auto-bind": "^4.0.0",
        "axios": "^0.19.2",
        "class-validator": "^0.12.2",
        "cli-progress": "^3.8.2",
        "commander": "^5.1.0",
        "concurrently": "^5.2.0",
        "config": "^3.3.1",
        "date-fns": "^2.15.0",
        "deep-diff": "^1.0.2",
        "diff-arrays-of-objects": "^1.1.6",
        "express": "^4.17.1",
        "express-graphql": "^0.11.0",
        "express-routemap": "^1.6.0",
        "graphql": "^15.3.0",
        "graphql-playground-middleware-express": "^1.7.18",
        "kiteconnect": "^3.1.0",
        "lodash": "^4.17.19",
        "morgan": "^1.10.0",
        "mysql": "^2.18.1",
        "node-config": "0.0.2",
        "nodemon": "^2.0.4",
        "p-limit": "^3.0.2",
        "redis": "^3.0.2",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "rxjs": "^6.6.0",
        "source-map-loader": "^1.0.0",
        "source-map-support": "^0.5.19",
        "tsc-watch": "^4.2.8",
        "type-graphql": "^1.0.0-rc.3",
        "typedi": "^0.8.0",
        "typeorm": "^0.2.25",
        "typescript": "^3.9.5",
        "wait-on": "^5.0.1",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@types/commander": "^2.12.2",
        "@types/config": "0.0.36",
        "@types/express": "^4.17.6",
        "@types/lodash": "^4.14.158",
        "@types/node": "^14.0.13",
        "@typescript-eslint/eslint-plugin": "^3.6.1",
        "@typescript-eslint/parser": "^3.6.1",
        "depcheck": "^1.0.0",
        "eslint": "^7.5.0",
        "eslint-config-prettier": "^6.11.0",
        "eslint-plugin-prettier": "^3.1.4",
        "eslint-plugin-simple-import-sort": "^5.0.3",
        "eslint-plugin-sonarjs": "^0.5.0",
        "eslint-plugin-unicorn": "^21.0.0",
        "prettier": "2.0.5"
    }
}
