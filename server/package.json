{
    "name": "trd",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "wait_for_db": "npx wait-on -l -v tcp:db:3306",
        "wait_for_redis": "npx wait-on -l -v tcp:redis:6379",
        "rimraf": "./node_modules/rimraf/bin.js",
        "build": "tsc -P tsconfig.json",
        "build:watch": "npm run build -- --watch --preserveWatchOutput --pretty",
        "server": "npm run server:build && node -r source-map-support/register ./dist/server/index.js",
        "server:build:clean": "rimraf dist/server",
        "server:dev": "npm run server:build:clean && tsc-watch --skipLibCheck --pretty --preserveWatchOutput -P tsconfig.json --onSuccess \"node -r source-map-support/register ./dist/server/index.js\"",
        "client:dev": "cd client && npx webpack-dev-server --content-base ./dist --hot --inline --color --port $WEBPACK_DEV_SERVER_PORT --host 0.0.0.0",
        "dev": "echo Hello; concurrently \"npm run server:dev\" \"npm run client:dev\"",
        "lint": "eslint '*/**/*.{js,ts,tsx}' --quiet --fix",
        "dist:run": "node -r source-map-support/register dist/server/index.js",
        "api-server": "npm run dist:run -- --api-server",
        "api-server:watch": "nodemon -w . -e js,ts -x \"npm run api-server || exit 0\""
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/auto-bind": "^2.1.0",
        "@types/deep-diff": "^1.0.0",
        "@types/morgan": "^1.9.1",
        "@types/redis": "^2.8.24",
        "auto-bind": "^4.0.0",
        "axios": "^0.19.2",
        "commander": "^5.1.0",
        "concurrently": "^5.2.0",
        "config": "^3.3.1",
        "deep-diff": "^1.0.2",
        "diff-arrays-of-objects": "^1.1.6",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "html-webpack-plugin": "^4.3.0",
        "kiteconnect": "^3.1.0",
        "lodash.once": "^4.1.1",
        "moment": "^2.27.0",
        "morgan": "^1.10.0",
        "mysql": "^2.18.1",
        "node-config": "0.0.2",
        "nodemon": "^2.0.4",
        "react": "^16.13.1",
        "react-dom": "^16.13.1",
        "redis": "^3.0.2",
        "redis-commands": "^1.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "rxjs": "^6.6.0",
        "source-map-loader": "^1.0.0",
        "source-map-support": "^0.5.19",
        "ts-loader": "^7.0.5",
        "ts-node": "^8.10.2",
        "tsc-watch": "^4.2.8",
        "typedi": "^0.8.0",
        "typeorm": "^0.2.25",
        "typescript": "^3.9.5",
        "wait-on": "^5.0.1",
        "webpack": "^4.43.0",
        "webpack-cli": "^3.3.11",
        "webpack-dev-server": "^3.11.0",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@types/commander": "^2.12.2",
        "@types/config": "0.0.36",
        "@types/dotenv": "^8.2.0",
        "@types/express": "^4.17.6",
        "@types/lodash.once": "^4.1.6",
        "@types/minimist": "^1.2.0",
        "@types/node": "^14.0.13",
        "@types/react": "^16.9.36",
        "@types/react-dom": "^16.9.8",
        "@typescript-eslint/eslint-plugin": "^3.2.0",
        "@typescript-eslint/parser": "^3.2.0",
        "eslint": "^7.2.0",
        "eslint-config-airbnb-base": "^14.2.0",
        "eslint-config-prettier": "^6.11.0",
        "eslint-config-standard": "^14.1.1",
        "eslint-plugin-import": "^2.21.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^3.1.3",
        "eslint-plugin-promise": "^4.2.1",
        "eslint-plugin-react": "^7.20.0",
        "eslint-plugin-standard": "^4.0.1",
        "prettier": "^2.0.5"
    }
}
