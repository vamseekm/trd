{
    "name": "trd",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "timestamp": "date",
        "wait_for_infra": "npx wait-on -l tcp:i_db:5432 tcp:i_redis:6379 tcp:i_rabbit:5672",
        "rimraf": "./node_modules/rimraf/bin.js",
        "build": "tsc -P tsconfig.json",
        "build:watch": "npm run build -- --watch --preserveWatchOutput --pretty",
        "server": "npm run server:build && node -r source-map-support/register ./dist/server/index.js",
        "server:build:clean": "rimraf dist/server",
        "server:dev": "npm run server:build:clean && tsc-watch --skipLibCheck --pretty --preserveWatchOutput -P tsconfig.json --onSuccess \"node -r source-map-support/register ./dist/server/index.js\"",
        "client:dev": "cd client && npx webpack-dev-server --content-base ./dist --hot --inline --color --port $WEBPACK_DEV_SERVER_PORT --host 0.0.0.0",
        "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
        "lint:fix": "npm run lint -- --fix",
        "lint:watch": "nodemon -w src -e ts -x \"npm run lint || exit 0\"",
        "dev": "NODE_ENV=dev npx tsc-watch --pretty --noClear -p . --onSuccess \"node -r source-map-support/register dist/cli/index.js\"",
        "dist:run": "date; node -r source-map-support/register dist/cli/index.js",
        "dist:doctor:run": "npm run timestamp; clinic doctor -- node -r source-map-support/register dist/cli/index.js",
        "dist:flame:run": "npm run timestamp; clinic flame -- node -r source-map-support/register dist/cli/index.js",
        "dist:bubble:run": "npm run timestamp; clinic bubbleprof -- node -r source-map-support/register dist/cli/index.js",
        "dist:prof:run": "npm run timestamp; node --prof -r source-map-support/register dist/cli/index.js",
        "api-server": "npm run dist:run -- --api-server",
        "run-debug": "npm run dist:run -- --debug",
        "run-debug:watch": "nodemon -w ./dist -e js -x \"npm run run-debug || exit 0\"",
        "api-server:watch": "nodemon -w ./dist -e js -x \"npm run api-server || exit 0\"",
        "pkgminor": "npm run ncu -- --target minor -u",
        "ncu": "npx ncu",
        "test": "jest",
        "test:watch": "npm run test -- --watchAll"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@types/bluebird": "^3.5.32",
        "@types/lru-cache": "^5.1.0",
        "@types/luxon": "^1.25.0",
        "@types/minimist": "^1.2.0",
        "@types/validator": "^13.1.0",
        "ajv": "^6.12.5",
        "ajv-keywords": "^3.5.2",
        "amqplib": "^0.6.0",
        "async-mutex": "^0.2.4",
        "axios": "^0.20.0",
        "cli-progress": "^3.8.2",
        "clinic": "^7.0.0",
        "concurrently": "^5.3.0",
        "config": "^3.3.2",
        "deasync": "^0.1.20",
        "deep-diff": "^1.0.2",
        "diff-arrays-of-objects": "^1.1.7",
        "express": "^4.17.1",
        "express-graphql": "^0.11.0",
        "express-routemap": "^1.6.0",
        "graphql": "^15.3.0",
        "graphql-playground-middleware-express": "^1.7.21",
        "kiteconnect": "^3.1.0",
        "lodash": "^4.17.20",
        "lru-cache": "^6.0.0",
        "luxon": "^1.25.0",
        "minimist": "^1.2.5",
        "morgan": "^1.10.0",
        "node-config": "0.0.2",
        "nodemon": "^2.0.4",
        "p-filter": "^2.1.0",
        "p-limit": "^3.0.2",
        "p-map": "^4.0.0",
        "pg": "^8.4.0",
        "pg-hstore": "^2.3.3",
        "redis": "^3.0.2",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "sequelize": "~5.22.3",
        "sequelize-typescript": "^1.1.0",
        "source-map-loader": "^1.1.0",
        "source-map-support": "^0.5.19",
        "synchronized-promise": "^0.3.1",
        "tsc-watch": "^4.2.9",
        "type-graphql": "^1.0.0",
        "wait-on": "^5.2.0",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@types/amqplib": "^0.5.13",
        "@types/cli-progress": "^3.8.0",
        "@types/config": "0.0.36",
        "@types/deep-diff": "^1.0.0",
        "@types/express": "^4.17.8",
        "@types/express-routemap": "^1.1.1",
        "@types/jest": "^26.0.14",
        "@types/lodash": "^4.14.161",
        "@types/morgan": "^1.9.1",
        "@types/node": "^14.11.2",
        "@types/redis": "^2.8.27",
        "@typescript-eslint/eslint-plugin": "^4.3.0",
        "@typescript-eslint/parser": "^4.3.0",
        "depcheck": "^1.2.0",
        "eslint": "^7.10.0",
        "eslint-config-prettier": "^6.12.0",
        "eslint-plugin-prettier": "^3.1.4",
        "eslint-plugin-simple-import-sort": "^5.0.3",
        "eslint-plugin-sonarjs": "^0.5.0",
        "eslint-plugin-unicorn": "^22.0.0",
        "jest": "^26.4.2",
        "npm-check-updates": "^9.0.3",
        "prettier": "2.1.2",
        "ts-jest": "^26.4.1",
        "typescript": "^4.0.3"
    }
}
