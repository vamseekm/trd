  "main": "index.js",
  "scripts": {
    "server": "node -r source-map-support/register ./dist/server/index.js",
    "server:build": "cd server && tsc",
    "server:build:clean": "rimraf dist/server",
    "server:dev": "tsc-watch -P server/tsconfig.json --onSuccess \"npm run server\"",
    "client:dev": "cd client && npx webpack-dev-server --content-base ./dist --hot --inline --color --port 3000",
    "dev": "echo Hello; concurrently \"npm run server:dev\" \"npm run client:dev\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^4.17.6",
    "@types/node": "^14.0.13",
    "@types/react": "^16.9.36",
    "@types/react-dom": "^16.9.8",
    "concurrently": "^5.2.0",
    "express": "^4.17.1",
    "html-webpack-plugin": "^4.3.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "rimraf": "^3.0.2",
    "source-map-loader": "^1.0.0",
    "source-map-support": "^0.5.19",
    "ts-loader": "^7.0.5",
    "ts-node": "^8.10.2",
    "tsc-watch": "^4.2.8",
    "typescript": "^3.9.5",
    "webpack": "^4.43.0",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.11.0"
  }
